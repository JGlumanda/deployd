# Production Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED
# ============================================

# Your domain name (without https://)
DOMAIN=portfolio.example.com

# Admin panel password (choose a strong one!)
ADMIN_PASSWORD=your-secure-password-here

# ============================================
# OPTIONAL
# ============================================

# GitHub Personal Access Token (increases API rate limit)
# Get one at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_token_here

# Node environment
NODE_ENV=production

# Allowed CORS origin (automatically set to https://${DOMAIN})
# ALLOWED_ORIGIN=https://portfolio.example.com
